{
  "name": "bahlou-desktop",
  "productName": "Bahlou",
  "version": "2.7.0",
  "description": "Bahlou, application de bureau",
  "author": "Rayan",
  "homepage": "https://github.com/RayanDrii/bahlou",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "eu.epitech.bahlou",
    "productName": "Bahlou",
    "files": [
      "main.js",
      "epitech-sync.js",
      "epitech-bridge.js",
      "preload.js",
      "setup.html",
      "splash.html",
      "logo-block.png",
      "offline.html",
      "fonts/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "maintainer": "RayanDrii",
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Bahlou",
      "description": "Le Salon et le Cercle de la promo.",
      "executableName": "bahlou"
    },
    "appImage": {
      "artifactName": "Bahlou-${version}.AppImage"
    },
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}